---
import Leaderboard from "@components/Leaderboard.svelte";
import type {
  HourlyData,
  RankingData,
} from "@goldstarboard/shared-types/interfaces";
import Layout from "@layouts/Layout.astro";
import { API_URL } from "astro:env/server";
import { getSecondsUntilNextUpdate } from "@utils/cache";

export const prerender = false;

// Caching since it take a while to load when going to the index page
if (Astro.cache.enabled) {
  Astro.cache.set({
    maxAge: getSecondsUntilNextUpdate(),
    tags: ["rankings"],
  });
}

let streakData: RankingData[] = [];
let starData: RankingData[] = [];
let hourlyData: HourlyData[] = [];

await Promise.try(async () => {
  [streakData, starData, hourlyData] = await Promise.all([
    fetch(`${API_URL}/streak-ranking`).then((r) => r.json()),
    fetch(`${API_URL}/star-ranking`).then((r) => r.json()),
    fetch(`${API_URL}/hourly-data`).then((r) => r.json()),
  ]);
}).catch((error) => {
  console.error("Failed to fetch rankings:", error);
});
---

<Layout title="Leaderboard">
  <div class="py-6 px-8">
    <Leaderboard
      client:load
      streakData={streakData}
      starData={starData}
      hourlyData={hourlyData}
    />
  </div>
</Layout>
